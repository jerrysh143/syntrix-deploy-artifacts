PassengerAppRoot /home/u133121911/domains/careers.syntrixglobal.in/hbuilds/current/nodejs
PassengerAppType node
PassengerNodejs /opt/alt/alt-nodejs24/root/bin/node
PassengerStartupFile server/index.mjs
PassengerBaseURI /
PassengerRestartDir /home/u133121911/domains/careers.syntrixglobal.in/hbuilds/current/nodejs/tmp
SetEnv NODE_OPTIONS "--require /home/u133121911/domains/careers.syntrixglobal.in/hbuilds/config/preload-timestamp.js"
SetEnv LSNODE_CONSOLE_LOG console.log

RewriteEngine On
RewriteRule ^sitemap\.xml$ /sitemap.txt [L]

<Files "sitemap.txt">
  PassengerEnabled off
  ForceType application/xml
  Header set Content-Type "application/xml; charset=utf-8"
</Files>

<Files "robots.txt">
  PassengerEnabled off
  ForceType text/plain
</Files>
