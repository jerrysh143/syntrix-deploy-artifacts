PassengerAppRoot /home/u133121911/domains/syntrixglobal.in/hbuilds/current/nodejs
PassengerAppType node
PassengerNodejs /opt/alt/alt-nodejs24/root/bin/node
PassengerStartupFile server/index.mjs
PassengerBaseURI /
PassengerRestartDir /home/u133121911/domains/syntrixglobal.in/hbuilds/current/nodejs/tmp
SetEnv NODE_OPTIONS "--require /home/u133121911/domains/syntrixglobal.in/hbuilds/config/preload-timestamp.js"
SetEnv LSNODE_CONSOLE_LOG console.log

# No physical sitemap.xml — Hostinger panel redirects /sitemap.xml → /serve-sitemap.php
<FilesMatch "^(robots\.txt|sitemap\.txt|serve-sitemap\.php)$">
  PassengerEnabled off
</FilesMatch>

<Files "sitemap.txt">
  ForceType application/xml
  Header set Content-Type "application/xml; charset=utf-8"
</Files>

<Files "robots.txt">
  ForceType text/plain
</Files>
